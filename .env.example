# ==========================
# Traefik & Domain Settings
# ==========================
# The domain used for Traefik routing (e.g., eric.linkerx.dev)
HOST=example.local

# ==========================
# Database (PostgreSQL)
# ==========================
# These are used to INITIALIZE the database container on first run
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=portfolio_db

# Internal connection settings (usually defaults are fine)
DB_HOST=db
DB_PORT=5432

# ==========================
# Backend API Settings
# ==========================
# Secret key for JWT/Sessions (Change this for production!)
SECRET_KEY=change_me_to_a_random_string

# API Configuration
API_PREFIX=/api
ENVIRONMENT=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Integrations
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================
# Frontend Build Settings
# ==========================
# This is baked into the Nginx static files during 'npm run build'
# Use '/api' for relative proxying or a full URL if hosting on a different domain
VITE_API_URL=/api
